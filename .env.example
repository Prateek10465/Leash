# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Leave blank to run in simulated mode (PayPal-shaped responses, no network calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox account that plays "the merchant". Payouts and orders are paid to this email.
LEASH_MERCHANT_EMAIL=
# Only needed if you register a webhook pointing at https://<your-host>/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# --- AI (optional; without a key Leash uses its rule engine and a scripted agent) ---
ANTHROPIC_API_KEY=
LEASH_MODEL=claude-haiku-5-5

# --- Product search (optional) ---
CHANNEL3_API_KEY=

# --- Server ---
PORT=3000
# Must match the host PayPal redirects the approving human back to.
BASE_URL=http://localhost:3000
